            },
            "legalLastName": {
              "type": "string",
              "maxLength": 30,
              "example": "Doe",
              "description": "#### Description\n  - This field specifies the last name of the individual (business owner / authorized signatory).\n#### Validation\n  - **Required** field\n  - Maximum length: 30\n"
            },
            "dateOfBirth": {
              "type": "string",
              "format": "date",
              "example": "1980-05-20",
