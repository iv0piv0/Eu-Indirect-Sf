    "/auth/access-token/revoke": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Revoke an access token",
        "description": "**Overview**\n\nThe Revoke Access Token endpoint allows clients to invalidate an existing access token by providing it in the accessToken field of the request body. Once revoked, the token is no longer usable for authentication or access to the platform. \n\n---\n\n**Key Features**<br>\n- **Token Revocation**: Specific token be revoked by explicitly sending it in the request body.\n- **Permanent Removal from Active Use**: The revoked token is completely invalidated and can no longer be used for authentication ensuring inactive or misused tokens are cleaned up from the system.\n\n---\n\n**Purpose and Use Cases**<br>\n- Invalidate an issued access token that is no longer needed or that comes with a security risk.\n- Allow authorized user to revoke user or client access.\n\n---\n\n**Expected Outcomes**<br>\n- The specified token is revoked and removed from active use.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeAccessTokenRequest"
              },
              "example": {
                "accessToken": "c8NOmPz3Qe6eO5x9GJz5tXz9Qe6eO5x9GJz5tXz9Qe6e..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeAccessTokenResponse"
                },
                "example": {
                  "description": "Success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingAccessToken": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_request",
                      "errorDescription": [
                        {
                          "field": "accessToken",
                          "issue": "Missing",
                          "description": "The field accessToken is required."
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "auth_error",
                      "errorDescription": "No access token found."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "auth_error",
                      "errorDescription": "The access token does not contain required permissions."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SystemError": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "system_error",
                      "errorDescription": "Internal server error."
                    }
                  }
                }
              }
            }
          }
        }
      }
