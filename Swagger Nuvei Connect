  "paths": {
    "/auth/clients/{clientId}/authenticate": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate an app client",
        "description": "**Overview**<br><br>\nThe Authenticate App Client API allows external clients (apps or systems) to securely authenticate using their credentials and receive an access token. After authentication, this token is used to perform authorized actions within the platform, like creating and retrieving applications, uploading documents etc.<br>\n\n---\n\n**Key Features**\n- **Token-Based Authentication:** Secure access via access token for client-server communication. \n- **Role and Scope Enforcement:** The access token includes detailed role and scope assignments, determined by the user's assigned role and the license associated with their account.\n- **Flexible Token Lifespan:** Supports short-lived tokens or long-lived tokens based on the request parameters.\n\n---\n\n**Purpose**\n- To securely authenticate application clients using **clientId** and **clientSecret**.  \n- To issue access tokens that carry permission scopes, roles, and domain identifiers for further API access.  \n\n---\n\n**Example Scenarios**\n- **System-to-System Authentication:** External app client authenticates using its 'clientId' and 'clientSecret' to retrieve a token and access onboarding APIs.  \n- **Non-Expiring Tokens for Service Integrations:** Token without expiration enabled for background services via the 'noTokenExpiry' flag if explicitly allowed.\n",
        "security": [],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "description": "ClientID specifies the unique identifier of the app client requesting authentication. This ID is used to locate the client's record for authentication. \n",
            "example": "6bc9fdef-70a9-4d1b-a02c-2017148d39a5",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRequest"
              },
              "examples": {
                "AuthenticateWithoutResourceOwnerWithExpiry": {
                  "value": {
                    "clientSecret": "Enter your client secret"
                  }
                },
                "AuthenticateWithoutResourceOwnerWithoutExpiry": {
                  "value": {
                    "clientSecret": "Enter your client secret",
                    "noTokenExpiry": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                },
                "examples": {
                  "AuthenticatedWithoutResourceOwner": {
                    "value": {
                      "accessToken": "c8NOmPz3Qe6eO5x9GJz5tXz9Qe6eO5x9GJz5tXz9Qe6e...",
                      "region": "NA"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingClientSecret": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_request",
                      "errorDescription": [
                        {
                          "field": "clientSecret",
                          "issue": "The field '{field}' is missing in your request. Please provide this field and try again."
                        }
                      ]
                    }
                  },
                  "NonExpiringTokensOnlyApplicableWithoutResourceOwner": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_request",
                      "errorDescription": "'noTokenExpiry' cannot be true when 'involvesResourceOwner' is true."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidClient": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_client",
                      "errorDescription": "An error occurred while generating the token. Azure AD B2C returned the error:'{field}'."
                    }
                  },
                  "MissingAccountOrRole": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "missing_account_or_role_association",
                      "errorDescription": "Neither accountId nor role is associated with the client ID specified."
                    }
                  },
                  "AccountNotExisting": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_account_association",
                      "errorDescription": "The account associated with the client ID specified does not exist."
                    }
                  },
                  "AccountWithoutValidLicense": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_account_association",
                      "errorDescription": "The account associated with the client ID specified does not have a valid license."
                    }
                  },
                  "RoleNotExisting": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "invalid_role_association",
                      "errorDescription": "The role associated with the client ID specified does not exist."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SystemError": {
                    "value": {
                      "errorType": "api_error",
                      "errorCode": "system_error",
                      "errorDescription": "An internal error occurred while authenticating the client '{field}'. Please try again later."
                    }
                  }
                }
              }
            }
          }
        }
      }
