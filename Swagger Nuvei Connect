              "minLength": 9,
              "maxLength": 9,
              "example": "123456789",
              "description": "#### Description\n  - This field specifies the Social Security Number (SSN) of the individual (business owner / authorized signatory).\n#### Validation\n  - **Optional field**\n  - Must be a 9-digit number in the format \"XXX-XX-XXXX\" or \"XXXXXXXXX\".\n  - Pattern: ^(\\d{3}-\\d{2}-\\d{4}|\\d{9})$\n"
            },
            "addresses": {
              "description": "#### Description\n  - This field identifies the location of business.\n  - It can be the location where the business has been registered or the location where the business is operating.\n  - It consists of **Address Type, Country, State Or Province, City, Postal Code, Address Line1, and Address Line2**.\n",
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "addressType": {
                        "type": "string",
                        "description": "#### Description\n  - Address Type specifies the type of business address provided by the user.<br>\n    - **Business Address:** This is the location where  the business is officially registered.<br>\n    - **Trading Address:** This is the physical location where the business operation occurs.\n\n#### Validation\n  - The address type in this field must be one of the two pre-defined values.\n",
                        "enum": [
                          "RESIDENTIAL_ADDRESS"
                        ]
                      }
                    },
                    "required": [
                      "addressType"
                    ]
                  },
                  {
                    "$ref": "#/components/schemas/schemas-Address"
                  }
                ]
              }
            },
            "email": {
              "description": "#### Description\n  - This field specifies the email of the business owner.\n#### Validation\n  - Required field\n  - Maximum length: 255\n  - Must match the regular expression pattern: '^(?!.*\\.\\.)[a-zA-Z0-9]+(?:[._-][a-zA-Z0-9]+)*@(?:[a-zA-Z\\d]+(?:-[a-zA-Z\\d]+)*\\.)+[a-zA-Z]{2,10}$'.\n",
              "allOf": [
                {
                  "$ref": "#/components/schemas/schemas-EmailAddress"
                }
              ]
            },
            "mobile": {
              "description": "#### Description\n  - This field specifies the mobile number of the business owner.\n#### Validation\n  - Required field\n",
              "allOf": [
                {
                  "$ref": "#/components/schemas/schemas-Mobile"
                }
              ]
            },
            "percentageOfOwnership": {
              "type": "number",
              "format": "float",
              "minimum": 0,
              "maximum": 100,
              "example": 75,
              "description": "#### Description\n  - This field specifies the ownership percentage held by the individual (business owner / authorized signatory) in the business.\n#### Validation\n  - **Required** field\n  - Minimum Value: 0\n  - Maximum Value: 100 \n  - The sum of ownership percentage held by total number of beneficial owners provided should not exceed 100%.\n"
            },
            "isMemberOfGoverningBoard": {
              "type": "boolean",
