    // ── Mocks ────────────────────────────────────────────────────────────

    /**
     * Multi-purpose mock: returns OAuth token for Session_Token_Endpoint,
     * a small PDF blob for Conga Composer, and a DocuSign envelope id for
     * the DocuSign REST call. Routes purely on URL fragments.
     */
    private class TrackDFullMock implements HttpCalloutMock {
        public HttpResponse respond(HttpRequest req) {
            HttpResponse res = new HttpResponse();
            String ep = req.getEndpoint() == null ? '' : req.getEndpoint();
            if (ep.contains('oauth2/token') || ep.contains('Session_Token_Endpoint')
                || ep.contains('/token')) {
                res.setStatusCode(200);
                res.setHeader('Content-Type', 'application/json');
                res.setBody('{"access_token":"FAKE-OAUTH-TOKEN"}');
            } else if (ep.contains('composer.congamerge.com')) {
                res.setStatusCode(200);
                res.setHeader('Content-Type', 'application/pdf');
                res.setBodyAsBlob(Blob.valueOf('FAKE-PDF-CONTENT'));
            } else if (ep.contains('docusign') || ep.contains('envelopes')
                || ep.contains('DocuSign_eSign')) {
                res.setStatusCode(201);
                res.setHeader('Content-Type', 'application/json');
                res.setBody('{"envelopeId":"a1b2c3d4-0000-1111-2222-deadbeefcafe","status":"sent"}');
            } else {
                // Default — treat as DocuSign envelope create response
                res.setStatusCode(201);
                res.setHeader('Content-Type', 'application/json');
                res.setBody('{"envelopeId":"a1b2c3d4-0000-1111-2222-deadbeefcafe","status":"sent"}');
            }
            return res;
        }
    }

    /** Conga returns HTTP 500 — exercises the Conga error branch. */
    private class CongaErrorMock implements HttpCalloutMock {
        public HttpResponse respond(HttpRequest req) {
            HttpResponse res = new HttpResponse();
            String ep = req.getEndpoint() == null ? '' : req.getEndpoint();
            if (ep.contains('/token') || ep.contains('oauth2')) {
                res.setStatusCode(200);
                res.setHeader('Content-Type', 'application/json');
                res.setBody('{"access_token":"FAKE-TOKEN"}');
            } else {
                res.setStatusCode(500);
                res.setBody('{"error":"conga down"}');
            }
            return res;
        }
    }

